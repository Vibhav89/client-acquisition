# Supabase project URL, e.g. https://your-project.supabase.co
SUPABASE_URL=
# Supabase publishable/anon key. Never put a service-role key here.
SUPABASE_ANON_KEY=
# Optional server port
PORT=3000

# Optional OpenAI-compatible AI provider (server-side only)
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://openrouter.ai/api/v1

# Ads are disabled until a publisher account is approved and ad-unit code is added.
VITE_ADS_ENABLED=false
# Paste the exact Adsterra Native Banner embed snippets as Base64 (one unique ad unit per placement).
# Generate separate Native Banner units in Adsterra for each placement; do not use Popunder/Interstitial/Social Bar.
VITE_ADSTERRA_NATIVE_BANNER_TOP_CODE_BASE64=
VITE_ADSTERRA_NATIVE_BANNER_FEED_CODE_BASE64=
