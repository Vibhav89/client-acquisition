# Supabase project URL, e.g. https://your-project.supabase.co
SUPABASE_URL=
# Supabase publishable/anon key. Never put a service-role key here.
SUPABASE_ANON_KEY=
# Optional server port
PORT=8787
# Personal browser radar is opt-in. Keep false unless running locally.
CLIENT_RADAR_BROWSER_ENABLED=false
# Persistent browser profiles are kept outside git via .gitignore.
CLIENT_RADAR_BROWSER_PROFILES=.client-radar/profiles
