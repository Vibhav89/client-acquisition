# Supabase project URL, e.g. https://your-project.supabase.co
SUPABASE_URL=
# Supabase publishable/anon key. Never put a service-role key here.
SUPABASE_ANON_KEY=
# Optional server port
PORT=3000

# Optional OpenAI-compatible AI provider (server-side only)
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://openrouter.ai/api/v1
